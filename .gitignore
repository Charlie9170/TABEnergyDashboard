# Streamlit - NEVER commit secrets or API keys
.streamlit/secrets.toml
# .streamlit/config.toml is intentionally tracked — it carries the deployed
# theme/server settings and holds no secrets.

# Data files (generated by ETL)
# Note: Small processed data files (<1MB) ARE committed for dashboard instant-load
# GitHub Actions updates these automatically every 6 hours
# data/*.parquet  # DISABLED - Allow parquet files for automated dashboard updates
data/*.csv
data/*.json
# Hand-curated mineral deposits — the only input to mineral_etl.py and the sole
# source of record for minerals_deposits.parquet. Tracked because nothing else
# can regenerate it, and the ETL now refuses to run without it.
!data/manual_mineral_deposits.csv
# GIS queue ETL provenance sidecar (Task 8) — small, human-readable,
# committed alongside queue.parquet so the validation gate and About tab
# can read the source report's own totals without re-fetching it.
!data/queue_gis_metadata.json
# Mineral formation polygons — manually digitized GeoJSON loaded at runtime
# by the minerals tab to draw formation overlays on the deposit map.
!data/mineral_polygons_v2.json

# Temporary files
*.tmp
*.log
.cache/
tmp/

